# Openbridge Authentication
OPENBRIDGE_REFRESH_TOKEN=YOUR_REFRESH_TOKEN
# Require a caller-provided Bearer credential by default.
OPENBRIDGE_REQUIRE_CLIENT_AUTH=true
# Dangerous compatibility escape hatch for deliberately isolated,
# single-tenant containers that must bind a non-loopback interface.
OPENBRIDGE_ALLOW_INSECURE_REMOTE_AUTH=false
# Deprecated URL path tokens are disabled by default. Enabling them requires
# refresh_token auth mode and a unique secret of at least 32 bytes.
MCP_PATH_TOKEN_ENABLED=false
# MCP_PATH_TOKEN_SECRET=
# MCP_PATH_TOKEN_TTL_DAYS=7
# MCP_PATH_TOKEN_MAX_AGE_DAYS=7

# Optional: API timeout in seconds (default: 30, connect timeout fixed at 10)
OPENBRIDGE_API_TIMEOUT=30

# MCP Server Configuration
MCP_PORT=8000
MCP_HOST=127.0.0.1

# Required for Docker Compose: encrypts task headers and tokens persisted in Redis.
# Generate with: openssl rand -hex 32
FASTMCP_TASKS_ENCRYPTION_KEY=

# Query Validation (AI-powered) - Optional, requires explicit opt-in
# Enable LLM-based query validation (default: false, uses heuristics only)
OPENBRIDGE_ENABLE_LLM_VALIDATION=false
# Query execution requires both a real API key and this explicit opt-in.
OPENBRIDGE_ENABLE_QUERY_EXECUTION=false

# A real API key enables validate_query and is also required for execute_query.
# Get your API key from: https://platform.openai.com/docs/api-reference/introduction
# FASTMCP_SAMPLING_API_KEY=
# or use OPENAI_API_KEY if you prefer
# OPENAI_API_KEY=

# Optional: Customize the model used for query validation (default: gpt-4o-mini)
# FASTMCP_SAMPLING_MODEL=gpt-4o-mini

# Optional: Use a custom OpenAI-compatible endpoint
# FASTMCP_SAMPLING_BASE_URL=https://api.openai.com/v1

# OAuth (only used when OPENBRIDGE_AUTH_MODE=oauth_proxy)
# Externally-reachable base URL of this server — used to construct the OAuth
# redirect URI. Required for production; defaults to http://{MCP_HOST}:{MCP_PORT}.
MCP_BASE_URL=http://localhost:8000/mcp

# Stable secret for signing FastMCP session tokens. If unset, a random key is
# generated per process start and sessions break on restart.
MCP_JWT_SIGNING_KEY=your-strong-secret-here

# Introspection endpoint credentials. Openbridge reads these from embedded secrets
# so the defaults work in most cases — override only if explicitly required.
OPENBRIDGE_OAUTH_CLIENT_ID=YOUR_OB_CLIENT_ID
OPENBRIDGE_OAUTH_CLIENT_SECRET=YOUR_OB_CLIENT_SECRET

# Base URL for Openbridge's OAuth endpoints. Defaults to https://authentication.api.openbridge.io
OPENBRIDGE_AUTH_BASE_URL=https://authentication.api.openbridge.io
