{
  "mcpServers": {
    "openbridge": {
      "required": true,
      "description": "Openbridge MCP server (FastMCP). Code Mode exposes tags/search/get_schema/execute. The default catalog is read-oriented. SQL tools and privileged credential-returning or mutation tools are conditional; always inspect get_capabilities before using them.",
      "type": "http",
      "url": "${OPENBRIDGE_MCP_URL:-https://mcp.openbridge.com/mcp/}",
      "tools": [
        "tags",
        "search",
        "get_schema",
        "execute",
        "get_capabilities",
        "get_jobs",
        "get_job_by_id",
        "get_history_by_id",
        "get_healthchecks",
        "get_subscriptions",
        "get_subscription_by_id",
        "get_storage_subscriptions",
        "search_products",
        "list_product_tables",
        "get_product_stage_ids",
        "get_table_schema",
        "get_suggested_table_names",
        "get_remote_identities",
        "get_remote_identity_by_id",
        "get_amazon_advertising_profiles"
      ],
      "conditional_tools": {
        "OPENBRIDGE_ENABLE_PRIVILEGED_TOOLS=true": [
          "get_amazon_api_access_token",
          "update_history_status",
          "create_job",
          "create_subscription",
          "update_subscription",
          "cancel_subscription"
        ]
      }
    }
  }
}
